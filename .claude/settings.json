{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npm uninstall *)",
      "Bash(npm ci)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npx vite*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx cypress run*)",
      "Bash(npx start-server-and-test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git fetch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge origin/master*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(gh pr close*)"
    ],
    "deny": [
      "Bash(git push * master*)",
      "Bash(git push *:master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  }
}
