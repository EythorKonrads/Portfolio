{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npm uninstall *)",
      "Bash(npm ci)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npx vite*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx cypress run*)",
      "Bash(npx start-server-and-test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git fetch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge origin/master*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit *)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git remote -v)",
      "Bash(git worktree list*)",
      "Bash(git worktree add *)"
    ],
    "ask": [
      "Bash(gh pr close*)"
    ],
    "deny": [
      "Bash(git push * master*)",
      "Bash(git push *:master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git switch *)",
            "command": "jq -r .tool_input.command | grep -qxE 'git switch (-c|--create) [^;&|]*' || test -z \"$(git status --porcelain)\" || printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"This worktree has uncommitted changes, which may belong to another session.\"}}'"
          },
          {
            "type": "command",
            "if": "Bash(git checkout *)",
            "command": "test -z \"$(git status --porcelain)\" || printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"This worktree has uncommitted changes, which may belong to another session.\"}}'"
          }
        ]
      }
    ]
  }
}
