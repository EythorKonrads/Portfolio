{
    "name": "portfolio",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test:open": "cypress open --e2e -b electron",
        "test:e2e": "vite build && node cypress/run-e2e.js",
        "test:e2e:quiet": "vite build --logLevel warn && node cypress/run-e2e.js --quiet --reporter dot",
        "test:component": "cypress run --component -b electron",
        "test:component:quiet": "cypress run --component -b electron --quiet --reporter dot",
        "test:component:open": "cypress open --component -b electron",
        "test:e2e:dev": "start-server-and-test 'vite dev --port 5173' http://localhost:5173 'cypress open --e2e -b electron'",
        "lint": "eslint . --fix",
        "check": "eslint . && prettier --check src/ cypress/ && npm run check:colors",
        "check:colors": "! grep -rnEi '#[0-9a-f]{3,8}\\b|(rgb|hsl)a?\\([0-9]' src --include='*.vue' --include='*.scss' --include='*.css' --include='*.js' --exclude=variables.scss",
        "format": "prettier --write src/ cypress/"
    },
    "dependencies": {
        "vite-svg-loader": "^5.1.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "cypress": "^16.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-cypress": "^7.0.2",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "sass": "^1.107.1",
        "start-server-and-test": "^3.0.13",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "wrangler": "^4.158.0"
    },
    "allowScripts": {
        "cypress@16.2.1": true
    }
}
