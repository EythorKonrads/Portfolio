        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "cypress": "^16.2.0",
        "eslint": "^10.13.0",
        "eslint-plugin-cypress": "^7.0.2",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "sass": "^1.105.2",
        "start-server-and-test": "^3.0.13",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.4"
